{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sfhs-doom.invalid/schema/artifact-manifest-1.json",
  "title": "SFHS Doom artifact evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_type",
    "project",
    "edition",
    "phase",
    "task",
    "source",
    "build",
    "artifacts",
    "verification",
    "notes"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "manifest_type": { "const": "artifact" },
    "project": { "const": "sfhs-doom" },
    "edition": { "type": "string", "minLength": 1 },
    "phase": { "const": "P00" },
    "task": { "type": "string", "pattern": "^DOOM-P[0-9]+-[0-9]{3}$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "upstream_tag", "upstream_sha", "dirty", "toolchains", "inputs"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "upstream_tag": { "type": "string", "minLength": 1 },
        "upstream_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "dirty": { "type": "boolean" },
        "toolchains": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version", "source"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 },
              "source": { "type": "string", "minLength": 1 }
            }
          }
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file_record"
          }
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["utc", "id", "commands"],
      "properties": {
        "utc": { "type": "string", "format": "date-time" },
        "id": { "type": "string", "minLength": 1 },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["argv", "cwd", "exit_code", "stdout_path", "stderr_path"],
            "properties": {
              "argv": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "cwd": { "type": "string", "minLength": 1 },
              "exit_code": { "type": "integer" },
              "stdout_path": { "type": "string", "minLength": 1 },
              "stderr_path": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/file_record" },
          {
            "type": "object",
            "required": ["kind"],
            "properties": {
              "kind": { "type": "string", "minLength": 1 }
            }
          }
        ]
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_ids", "result", "checks"],
      "properties": {
        "run_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "result": { "enum": ["PASS", "FAIL", "BLOCKED"] },
        "checks": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "notes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "file_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size_bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
